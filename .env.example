# ─── Database (Microsoft SQL Server) ───────────────────────────────────────────
# Windows authentication against a local SQL Server Express instance (TCP/IP must be enabled):
DATABASE_URL="sqlserver://localhost:1433;database=RewardingPotential;integratedSecurity=true;trustServerCertificate=true"
# SQL authentication (servers / production):
# DATABASE_URL="sqlserver://db-host:1433;database=RewardingPotential;user=rp_app;password=CHANGE_ME;encrypt=true"

# Public base URL of the site (used in emails and payment callbacks)
APP_URL="http://localhost:3000"

# ─── Payments ─────────────────────────────────────────────────────────────────
# sandbox = demo gateway for local development (no real money, excluded from revenue)
# live    = only after real gateway credentials, business authorization and legal checks
PAYMENT_MODE="sandbox"
# HMAC secret used to sign/verify sandbox gateway callbacks (any long random string)
SANDBOX_WEBHOOK_SECRET="replace-with-a-long-random-string"
# Real gateway credentials (leave empty until a merchant agreement exists)
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""

# ─── Email (optional). Without SMTP, emails are stored in Admin → Email outbox ─
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Parwaz Testing Service <no-reply@example.com>"

# ─── SMS (optional, provider adapter not enabled by default) ──────────────────
SMS_PROVIDER=""
SMS_API_KEY=""

# Secret for the scheduled maintenance endpoint (/api/cron/maintenance)
CRON_SECRET="replace-with-a-long-random-string"


# ─── Demo accounts created by `npm run db:seed` ───────────────────────────────
SEED_ADMIN_EMAIL="admin@rewardingpotential.test"
SEED_ADMIN_PASSWORD="choose-a-strong-password"
SEED_STUDENT_EMAIL="student@rewardingpotential.test"
SEED_STUDENT_PASSWORD="choose-a-strong-password"
