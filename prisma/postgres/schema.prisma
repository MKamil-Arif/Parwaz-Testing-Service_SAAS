generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ───────────────────────────── Identity & access ─────────────────────────────

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique @db.VarChar(256)
  fullName           String    @db.VarChar(150)
  phone              String    @db.VarChar(20)
  passwordHash       String    @db.VarChar(100)
  status             String    @default("ACTIVE") @db.VarChar(20)
  emailVerifiedAt    DateTime?
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  referralCode       String    @unique @db.VarChar(16)
  signupCampaignId   Int?
  isDemo             Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  signupCampaign MarketingCampaign? @relation(fields: [signupCampaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profile        StudentProfile?
  roles          UserRole[]
  sessions       Session[]
  authTokens     AuthToken[]
  registrations  CompetitionRegistration[]
  notifications  Notification[]
  supportTickets SupportTicket[]           @relation("TicketOwner")
  referralsMade  Referral[]                @relation("Referrer")
  referredBy     Referral?                 @relation("Referred")

  @@index([status])
  @@index([createdAt])
  @@index([signupCampaignId])
}

model Role {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(50)
  description String?    @db.VarChar(255)
  users       UserRole[]
}

model UserRole {
  userId     Int
  roleId     Int
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, roleId])
  @@index([roleId])
}

model Session {
  id         Int      @id @default(autoincrement())
  userId     Int
  tokenHash  String   @unique @db.VarChar(64)
  expiresAt  DateTime
  ipAddress  String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(400)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([expiresAt])
}

/// Single-use tokens for email verification and password reset (only the SHA-256 hash is stored).
model AuthToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      String    @db.VarChar(30)
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, type])
}

model StudentProfile {
  id                      Int       @id @default(autoincrement())
  userId                  Int       @unique
  city                    String    @db.VarChar(100)
  district                String    @db.VarChar(100)
  institution             String    @db.VarChar(200)
  classLevel              String    @db.VarChar(20)
  dateOfBirth             DateTime  @db.Date
  guardianName            String?   @db.VarChar(150)
  guardianPhone           String?   @db.VarChar(20)
  guardianRelation        String?   @db.VarChar(50)
  guardianConsentAt       DateTime?
  guardianConsentVerified Boolean   @default(false)
  leaderboardNameMode     String    @default("INITIALS") @db.VarChar(20)
  mediaConsent            Boolean   @default(false)
  termsAcceptedAt         DateTime
  updatedAt               DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([district])
  @@index([classLevel])
}

// ───────────────────────────── Competitions ─────────────────────────────

model Competition {
  id                   Int       @id @default(autoincrement())
  slug                 String    @unique @db.VarChar(120)
  title                String    @db.VarChar(200)
  summary              String    @db.VarChar(500)
  description          String    @db.Text
  subjects             String    @db.VarChar(300)
  eligibilityText      String    @db.Text
  rules                String    @db.Text
  tieBreakPolicy       String    @db.Text
  eligibleProvince     String?   @db.VarChar(50)
  minAge               Int?
  maxAge               Int?
  registrationFee      Decimal   @db.Decimal(12, 2)
  targetRegistrations  Int?
  maxRegistrations     Int?
  registrationOpensAt  DateTime
  registrationClosesAt DateTime
  examStartsAt         DateTime
  examEndsAt           DateTime
  durationMinutes      Int
  questionCount        Int
  marksPerQuestion     Float?
  totalMarks           Float
  negativeMarking      Float     @default(0)
  maxAttempts          Int       @default(1)
  randomizeQuestions   Boolean   @default(true)
  randomizeOptions     Boolean   @default(true)
  showInstantResults   Boolean   @default(false)
  status               String    @default("DRAFT") @db.VarChar(20)
  resultsStatus        String    @default("PENDING") @db.VarChar(20)
  meritGeneratedAt     DateTime?
  resultsApprovedAt    DateTime?
  resultsApprovedById  Int?
  resultsPublishedAt   DateTime?
  resultsPublishedById Int?
  isDemo               Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  eligibleClasses CompetitionEligibleClass[]
  questions       CompetitionQuestion[]
  prizes          Prize[]
  registrations   CompetitionRegistration[]
  ceremonies      AwardCeremony[]
  projections     FinancialProjection[]
  expenses        BusinessExpense[]
  announcements   Announcement[]
  landingPages    MarketingCampaign[]
  supportTickets  SupportTicket[]

  @@index([status, examStartsAt])
}

model CompetitionEligibleClass {
  competitionId Int
  classLevel    String @db.VarChar(20)

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([competitionId, classLevel])
}

/// Prize tier of a competition, e.g. ranks 1-10 receive a laptop.
model Prize {
  id                 Int      @id @default(autoincrement())
  competitionId      Int
  title              String   @db.VarChar(150)
  category           String   @db.VarChar(30)
  description        String?  @db.VarChar(1000)
  rankFrom           Int
  rankTo             Int
  quantity           Int
  estimatedUnitValue Decimal  @db.Decimal(12, 2)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  competition Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  allocations PrizeAllocation[]
  purchases   BusinessExpense[]

  @@index([competitionId])
}

model CompetitionRegistration {
  id                     Int       @id @default(autoincrement())
  registrationNumber     String    @unique @db.VarChar(30)
  userId                 Int
  competitionId          Int
  status                 String    @db.VarChar(30)
  eligibilityConfirmedAt DateTime
  rulesAcceptedAt        DateTime
  confirmedAt            DateTime?
  cancelledAt            DateTime?
  cancellationReason     String?   @db.VarChar(500)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  competition Competition   @relation(fields: [competitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments    Payment[]
  attempts    ExamAttempt[]

  @@unique([userId, competitionId])
  @@index([competitionId, status])
  @@index([createdAt])
}

// ───────────────────────────── Payments ─────────────────────────────

model Payment {
  id                   Int       @id @default(autoincrement())
  reference            String    @unique @db.VarChar(40)
  registrationId       Int
  amount               Decimal   @db.Decimal(12, 2)
  currency             String    @default("PKR") @db.VarChar(3)
  method               String    @db.VarChar(30)
  status               String    @db.VarChar(30)
  isSandbox            Boolean   @default(false)
  gatewayTransactionId String?   @db.VarChar(100)
  payerReference       String?   @db.VarChar(100)
  payerAccount         String?   @db.VarChar(100)
  payerNote            String?   @db.VarChar(500)
  failureReason        String?   @db.VarChar(500)
  paidAt               DateTime?
  verifiedAt           DateTime?
  verifiedById         Int?
  refundStatus         String?   @db.VarChar(30)
  refundAmount         Decimal?  @db.Decimal(12, 2)
  refundReason         String?   @db.VarChar(500)
  refundedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  registration CompetitionRegistration @relation(fields: [registrationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events       PaymentEvent[]

  @@index([registrationId])
  @@index([status])
  @@index([createdAt])
}

/// Raw gateway callbacks/webhooks with their signature-verification outcome (audit trail).
model PaymentEvent {
  id             Int      @id @default(autoincrement())
  paymentId      Int?
  provider       String   @db.VarChar(30)
  eventType      String   @db.VarChar(50)
  payload        String   @db.Text
  signatureValid Boolean
  outcome        String   @db.VarChar(200)
  createdAt      DateTime @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([paymentId])
}

// ───────────────────────────── Question bank ─────────────────────────────

model QuestionCategory {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(100)
  description String?    @db.VarChar(500)
  questions   Question[]
}

model Question {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  type        String   @default("MCQ") @db.VarChar(20)
  text        String   @db.Text
  explanation String?  @db.Text
  difficulty  String   @default("MEDIUM") @db.VarChar(10)
  marks       Float    @default(1)
  status      String   @default("ACTIVE") @db.VarChar(20)
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category     QuestionCategory      @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  options      AnswerOption[]
  competitions CompetitionQuestion[]
  answers      StudentAnswer[]

  @@index([categoryId, status])
}

model AnswerOption {
  id         Int     @id @default(autoincrement())
  questionId Int
  text       String  @db.VarChar(1000)
  isCorrect  Boolean @default(false)
  sortOrder  Int

  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  selected StudentAnswer[]

  @@index([questionId])
}

/// The question pool a competition draws its examination from.
model CompetitionQuestion {
  competitionId Int
  questionId    Int
  addedAt       DateTime @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([competitionId, questionId])
  @@index([questionId])
}

// ───────────────────────────── Examinations ─────────────────────────────

model ExamAttempt {
  id                  Int       @id @default(autoincrement())
  publicId            String    @unique @db.VarChar(32)
  registrationId      Int
  attemptNumber       Int
  status              String    @db.VarChar(20)
  startedAt           DateTime
  expiresAt           DateTime
  submittedAt         DateTime?
  submissionType      String?   @db.VarChar(20)
  identityConfirmedAt DateTime
  sessionId           Int?
  ipAddress           String?   @db.VarChar(64)
  userAgent           String?   @db.VarChar(400)
  lastSavedAt         DateTime?
  flagCount           Int       @default(0)
  voidReason          String?   @db.VarChar(500)

  registration CompetitionRegistration @relation(fields: [registrationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  answers      StudentAnswer[]
  activityLogs ExamActivityLog[]
  result       ExamResult?

  @@unique([registrationId, attemptNumber])
  @@index([status, expiresAt])
}

/// One row per question served in an attempt; also stores the randomized order.
model StudentAnswer {
  id               Int       @id @default(autoincrement())
  attemptId        Int
  questionId       Int
  position         Int
  optionOrder      String    @db.VarChar(200)
  selectedOptionId Int?
  textAnswer       String?   @db.Text
  markedForReview  Boolean   @default(false)
  answeredAt       DateTime?
  isCorrect        Boolean?
  marksAwarded     Float?
  reviewedById     Int?
  reviewedAt       DateTime?
  reviewNote       String?   @db.VarChar(500)

  attempt        ExamAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  question       Question      @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  selectedOption AnswerOption? @relation(fields: [selectedOptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([attemptId, questionId])
  @@unique([attemptId, position])
  @@index([questionId])
}

model ExamActivityLog {
  id        Int      @id @default(autoincrement())
  attemptId Int
  eventType String   @db.VarChar(40)
  details   String?  @db.VarChar(500)
  ipAddress String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([attemptId])
}

// ───────────────────────────── Results & prizes ─────────────────────────────

/// Graded outcome of an attempt. meritRank is assigned when the merit list is generated;
/// the leaderboard is this table filtered to published competitions.
model ExamResult {
  id                 Int       @id @default(autoincrement())
  attemptId          Int       @unique
  totalQuestions     Int
  correctCount       Int
  incorrectCount     Int
  unansweredCount    Int
  pendingReviewCount Int       @default(0)
  score              Float
  maxScore           Float
  percentage         Float
  timeTakenSeconds   Int
  status             String    @db.VarChar(20)
  meritRank          Int?
  verifiedById       Int?
  verifiedAt         DateTime?
  notes              String?   @db.VarChar(1000)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  attempt         ExamAttempt       @relation(fields: [attemptId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  changeLogs      ResultChangeLog[]
  prizeAllocation PrizeAllocation?
  disputes        SupportTicket[]

  @@index([status])
  @@index([meritRank])
}

model ResultChangeLog {
  id          Int      @id @default(autoincrement())
  resultId    Int
  changedById Int?
  field       String   @db.VarChar(50)
  oldValue    String?  @db.VarChar(200)
  newValue    String?  @db.VarChar(200)
  reason      String   @db.VarChar(1000)
  createdAt   DateTime @default(now())

  result ExamResult @relation(fields: [resultId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([resultId])
}

model PrizeAllocation {
  id                Int       @id @default(autoincrement())
  prizeId           Int
  resultId          Int       @unique
  rank              Int
  status            String    @db.VarChar(30)
  verificationNotes String?   @db.VarChar(1000)
  verifiedById      Int?
  verifiedAt        DateTime?
  publicApproved    Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  prize        Prize              @relation(fields: [prizeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  result       ExamResult         @relation(fields: [resultId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  distribution PrizeDistribution?

  @@index([prizeId])
  @@index([status])
}

model PrizeDistribution {
  id                 Int       @id @default(autoincrement())
  allocationId       Int       @unique
  status             String    @db.VarChar(30)
  method             String    @db.VarChar(30)
  ceremonyId         Int?
  scheduledDate      DateTime?
  deliveredAt        DateTime?
  deliveryAddress    String?   @db.VarChar(500)
  trackingReference  String?   @db.VarChar(100)
  deviceSerialNumber String?   @db.VarChar(100)
  receivedBy         String?   @db.VarChar(150)
  notes              String?   @db.VarChar(1000)
  updatedAt          DateTime  @updatedAt

  allocation PrizeAllocation @relation(fields: [allocationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ceremony   AwardCeremony?  @relation(fields: [ceremonyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([ceremonyId])
}

// ───────────────────────────── Award ceremonies ─────────────────────────────

model AwardCeremony {
  id            Int       @id @default(autoincrement())
  slug          String    @unique @db.VarChar(120)
  title         String    @db.VarChar(200)
  city          String    @db.VarChar(100)
  venue         String    @db.VarChar(300)
  eventDate     DateTime
  description   String    @db.Text
  status        String    @default("DRAFT") @db.VarChar(20)
  competitionId Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  competition   Competition?        @relation(fields: [competitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  media         CeremonyMedia[]
  distributions PrizeDistribution[]
  announcements Announcement[]

  @@index([status, eventDate])
}

/// Photos must have consentConfirmed=true (consent from every identifiable student/guardian) to be shown publicly.
model CeremonyMedia {
  id               Int      @id @default(autoincrement())
  ceremonyId       Int
  type             String   @db.VarChar(10)
  url              String   @db.VarChar(500)
  caption          String?  @db.VarChar(300)
  consentConfirmed Boolean  @default(false)
  isPublished      Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  ceremony AwardCeremony @relation(fields: [ceremonyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ceremonyId])
}

/// Uploaded image bytes, stored in the database so uploads work on serverless hosts (no persistent disk).
model MediaFile {
  id          Int      @id @default(autoincrement())
  publicId    String   @unique @db.VarChar(32)
  contentType String   @db.VarChar(50)
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
}

// ───────────────────────────── Communication ─────────────────────────────

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(200)
  body      String    @db.VarChar(2000)
  link      String?   @db.VarChar(300)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, readAt])
  @@index([createdAt])
}

/// Admin-sent announcement to a group of users (fanned out into Notification rows).
model NotificationBroadcast {
  id             Int      @id @default(autoincrement())
  title          String   @db.VarChar(200)
  body           String   @db.VarChar(2000)
  link           String?  @db.VarChar(300)
  audience       String   @db.VarChar(40)
  competitionId  Int?
  channels       String   @db.VarChar(50)
  recipientCount Int
  sentById       Int?
  createdAt      DateTime @default(now())
}

/// Every outgoing email. Without SMTP configured, emails are only logged here (development).
model EmailOutbox {
  id        Int       @id @default(autoincrement())
  toEmail   String    @db.VarChar(256)
  subject   String    @db.VarChar(300)
  body      String    @db.Text
  status    String    @db.VarChar(20)
  error     String?   @db.VarChar(1000)
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([createdAt])
}

model SupportTicket {
  id            Int      @id @default(autoincrement())
  ticketNumber  String   @unique @db.VarChar(30)
  userId        Int?
  name          String   @db.VarChar(150)
  email         String   @db.VarChar(256)
  phone         String?  @db.VarChar(20)
  subject       String   @db.VarChar(200)
  category      String   @db.VarChar(30)
  status        String   @default("OPEN") @db.VarChar(20)
  priority      String   @default("NORMAL") @db.VarChar(10)
  competitionId Int?
  resultId      Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User?            @relation("TicketOwner", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  competition Competition?     @relation(fields: [competitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  result      ExamResult?      @relation(fields: [resultId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages    SupportMessage[]

  @@index([status, category])
  @@index([userId])
}

model SupportMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int?
  isStaff   Boolean  @default(false)
  body      String   @db.Text
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ticketId])
}

// ───────────────────────────── Marketing ─────────────────────────────

model MarketingCampaign {
  id                   Int       @id @default(autoincrement())
  name                 String    @db.VarChar(150)
  slug                 String    @unique @db.VarChar(80)
  channel              String    @db.VarChar(30)
  status               String    @default("PLANNED") @db.VarChar(20)
  startDate            DateTime  @db.Date
  endDate              DateTime? @db.Date
  budget               Decimal?  @db.Decimal(12, 2)
  notes                String?   @db.VarChar(2000)
  visitCount           Int       @default(0)
  landingEnabled       Boolean   @default(false)
  landingHeadline      String?   @db.VarChar(200)
  landingBody          String?   @db.Text
  landingCompetitionId Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  landingCompetition Competition?      @relation(fields: [landingCompetitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  signups            User[]
  expenses           BusinessExpense[]

  @@index([status])
}

model Referral {
  id             Int       @id @default(autoincrement())
  referrerId     Int
  referredUserId Int       @unique
  status         String    @db.VarChar(20)
  createdAt      DateTime  @default(now())
  convertedAt    DateTime?

  referrer     User @relation("Referrer", fields: [referrerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referredUser User @relation("Referred", fields: [referredUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([referrerId])
}

model NewsletterSubscriber {
  id               Int      @id @default(autoincrement())
  email            String   @unique @db.VarChar(256)
  source           String?  @db.VarChar(80)
  status           String   @default("SUBSCRIBED") @db.VarChar(20)
  unsubscribeToken String   @unique @db.VarChar(64)
  consentAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// News items, site-wide promotional banners and ceremony announcements.
model Announcement {
  id            Int       @id @default(autoincrement())
  type          String    @db.VarChar(20)
  title         String    @db.VarChar(200)
  body          String    @db.Text
  linkUrl       String?   @db.VarChar(300)
  linkLabel     String?   @db.VarChar(60)
  isPublished   Boolean   @default(false)
  startsAt      DateTime?
  endsAt        DateTime?
  competitionId Int?
  ceremonyId    Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  competition Competition?   @relation(fields: [competitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ceremony    AwardCeremony? @relation(fields: [ceremonyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([type, isPublished])
}

// ───────────────────────────── Finance ─────────────────────────────

model BusinessExpense {
  id               Int      @id @default(autoincrement())
  category         String   @db.VarChar(30)
  description      String   @db.VarChar(300)
  amount           Decimal  @db.Decimal(12, 2)
  expenseDate      DateTime @db.Date
  vendor           String?  @db.VarChar(150)
  receiptReference String?  @db.VarChar(100)
  quantity         Int?
  prizeId          Int?
  campaignId       Int?
  competitionId    Int?
  recordedById     Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  prize       Prize?             @relation(fields: [prizeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  campaign    MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  competition Competition?       @relation(fields: [competitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([category])
  @@index([expenseDate])
}

/// Projected (budgeted) figures. Kept apart from actual payments and expenses.
model FinancialProjection {
  id            Int      @id @default(autoincrement())
  competitionId Int?
  type          String   @db.VarChar(10)
  category      String   @db.VarChar(30)
  label         String   @db.VarChar(150)
  amount        Decimal  @db.Decimal(12, 2)
  sortOrder     Int      @default(0)
  notes         String?  @db.VarChar(500)
  updatedAt     DateTime @updatedAt

  competition Competition? @relation(fields: [competitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// ───────────────────────────── Website content ─────────────────────────────

model SiteSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model ContentPage {
  id        Int      @id @default(autoincrement())
  slug      String   @unique @db.VarChar(80)
  title     String   @db.VarChar(200)
  body      String   @db.Text
  updatedAt DateTime @updatedAt
}

model FaqItem {
  id          Int      @id @default(autoincrement())
  category    String   @db.VarChar(30)
  question    String   @db.VarChar(400)
  answer      String   @db.Text
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(150)
  role            String   @db.VarChar(150)
  quote           String   @db.VarChar(1000)
  isSample        Boolean  @default(false)
  consentObtained Boolean  @default(false)
  isPublished     Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  actorEmail String?  @db.VarChar(256)
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(50)
  entityId   String?  @db.VarChar(50)
  details    String?  @db.Text
  ipAddress  String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
